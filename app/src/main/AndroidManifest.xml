<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the Nagios instances the user configures. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        From Android 17, reaching an address on the local network needs this as well. Asked for
        only when a profile's address looks local (docs/adr/0007). Older Android ignores it.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Telling the person about new problems. Asked for only when a profile's notifications are switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Background polling is WorkManager's, and it brings three permissions of its own that the
        app does use: to stay awake for the length of one poll, to wait for a network, and to put
        its schedule back after a restart. WorkManager also asks for FOREGROUND_SERVICE, which the
        app now uses itself, below.
    -->

    <!--
        A loud alert (docs/adr/0013). From Android 17, an app in the background is heard only from
        a foreground service, and only an app that holds the exact-alarm permission may play as an
        alarm from it. A service cannot be started from the background either, except as an exact
        alarm goes off, so the app sets one for now when a loud alert is due, and for nothing else. The person grants it, as
        "Alarms & reminders", when they switch loud alerts on, and can take it back.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A loud alert buzzes as well as sounding. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NagwatchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nagwatch">
        <!-- singleTop: a notification tapped while the app is open is handed to it, not opened as a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            How a notification's tap comes in. MainActivity has to be exported, because the
            launcher starts it, so any app can send it an intent. This second name for it is
            not exported: only Nagwatch itself, and Android acting on one of Nagwatch's own
            notifications, can use it. The app acts on a "go to this host" request only when it
            arrived by this name, so another app cannot steer it.
        -->
        <!--
            The home-screen widget. Android requires a widget's receiver to be exported; the
            broadcasts it acts on are ones only the system may send.
        -->
        <receiver
            android:name=".widget.StatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_widget_info" />
        </receiver>

        <!--
            Chooses a widget's profile. Exported because the launcher starts it. It accepts a
            widget's number from the intent and nothing else, and only one of this app's widgets.
        -->
        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Where a button on a notification (Acknowledge, Recheck) arrives. Not exported: only
            Nagwatch itself, and Android acting on one of Nagwatch's own notifications, can send
            to it. What it does changes a Nagios, so nothing else on the phone may reach it.
        -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- Plays a loud alert, for at most ten seconds. Not exported: only the app starts it. -->
        <service
            android:name=".notify.LoudAlertService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Where the exact alarm that starts a loud alert goes off. Not exported. -->
        <receiver
            android:name=".notify.LoudAlertAlarmReceiver"
            android:exported="false" />

        <!-- Stops a loud alert: its Stop button, or a loud notification swiped away. Not exported. -->
        <receiver
            android:name=".notify.StopLoudAlertReceiver"
            android:exported="false" />

        <activity-alias
            android:name=".notify.FromNotification"
            android:exported="false"
            android:targetActivity=".MainActivity" />
    </application>

</manifest>
