<!-- The release tick, with a "D" at the lower right so the debug build cannot be mistaken for the
     release one. Overrides app/src/main/res/drawable/ic_launcher_foreground.xml; both are drawn
     inside the adaptive icon's safe zone (the middle 66 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,59 L33,48 L29,52 L44,67 L74,37 L70,33 Z" />
    <!-- A "D", 15 wide and 15 tall, at the lower right. Every corner of it, and of the tick, is within 31 of
         the centre: a round launcher mask keeps a circle of 33 (a square one keeps more), so none is cut. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M60,62 L66,62 C72,62 75,65.5 75,69.5 C75,73.5 72,77 66,77 L60,77 Z M64,66 L64,73 L66,73 C69,73 71,71.5 71,69.5 C71,67.5 69,66 66,66 Z" />
</vector>
