<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only. Lets a developer run a background poll now, over adb, without
            waiting out Android's fifteen minutes (docs/development.md, "Background polling").
            It asks for the DUMP permission, which adb's shell and the system hold and no
            ordinary app can, so nothing else on the phone can use it.
        -->
        <receiver
            android:name="net.pgmac.nagwatch.debug.PollNowReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
            Debug builds only. Posts one notification of every kind, with made-up problems and a
            profile of its own, to see what they look like (docs/development.md, "Background
            polling"). Same permission, for the same reason.
        -->
        <receiver
            android:name="net.pgmac.nagwatch.debug.SampleNotificationsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
